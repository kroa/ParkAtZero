# ─────────────────────────────────────────────────────────────
#  ParkAtZero 환경변수 예시
#
#  실제 값은 .env.local 에 넣으세요. .env.local 은 .gitignore 에 등록되어 있습니다.
#      cp .env.example .env.local
#
#  ⚠️ VITE_ 접두사가 붙은 값은 **브라우저 번들에 그대로 노출**됩니다.
#     공공데이터포털 인증키처럼 비공개여야 하는 값은 VITE_ 를 붙이지 말고
#     Cloudflare Pages Functions(functions/api/parkings.ts) 프록시를 통해 사용하세요.
# ─────────────────────────────────────────────────────────────

# ── 1. 주차장 데이터 ────────────────────────────────────────

# 정적 시드 데이터 경로. 네트워크 없이도 앱이 즉시 뜨게 하는 Local-First 의 기반.
VITE_PARKING_SEED_URL=/data/parkings.sample.json

# [권장] 서버리스 프록시 경로. 인증키를 서버 측에만 두고 호출한다.
# 비워두면 원격 갱신을 건너뛰고 시드/캐시 데이터만 사용한다.
VITE_PARKING_API_PROXY=/api/parkings

# [개발 전용] 프록시 없이 브라우저에서 직접 호출할 때만 사용.
# odcloud 예: https://api.odcloud.kr/api/15012890/v1/uddi:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_PARKING_API_BASE=
VITE_PARKING_API_KEY=
VITE_PARKING_API_PER_PAGE=1000

# 로컬 캐시 유효시간 (ms). 기본 6시간.
VITE_CACHE_TTL_MS=21600000

# ── 2. 장소 검색 (선택) ─────────────────────────────────────
# 카카오 REST API 키. 없으면 내장 랜드마크 사전으로 동작한다.
VITE_KAKAO_REST_KEY=

# ── 3. 지도 타일 (기본값은 API 키가 필요 없는 CARTO 베이스맵) ──
VITE_MAP_TILE_LIGHT=https://basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
VITE_MAP_TILE_DARK=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# ── 4. 광고 (Ezoic) ─────────────────────────────────────────
# 로컬/CI 에서는 false 로 두어 레이아웃 검증이 흔들리지 않게 한다.
VITE_ADS_ENABLED=false
VITE_EZOIC_PLACEHOLDER_LIST=101
VITE_EZOIC_PLACEHOLDER_BOTTOM=102

# ── 5. 테스트 ───────────────────────────────────────────────
# Playwright 실행용 빌드에서만 true. 애니메이션을 줄이고 테스트 브리지를 노출한다.
VITE_E2E=false
